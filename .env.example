# ── ANTHROPIC ─────────────────────────────────────────────
# Get from: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── DATABASE (Railway PostgreSQL) ─────────────────────────
# Railway auto-provides this when you add the PostgreSQL plugin
DATABASE_URL=postgresql://user:password@host:5432/railway

# ── NEXTAUTH ──────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here
# Set to your Railway web app URL in production
NEXTAUTH_URL=http://localhost:3000

# ── TELEGRAM BOT ──────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here
# Set to your Railway bot app URL in production (for webhook mode)
TELEGRAM_WEBHOOK_URL=

# ── BOT <-> WEB APP SECURITY ──────────────────────────────
# Random string shared between bot and web app to authenticate bot calls
# Generate: openssl rand -hex 16
BOT_API_SECRET=your-random-bot-secret-here

# ── APP ───────────────────────────────────────────────────
# URL of your web app (used by bot to call /api/ai)
NEXT_PUBLIC_APP_URL=http://localhost:3000
